{
    "name": "dotkernel/dot-rbac",
    "type": "library",
    "description": "DotKernel RBAC authorization component",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-rbac",
    "keywords": [
        "laminas",
        "mezzio",
        "rbac"
    ],
    "authors": [
        {
            "name": "DotKernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "laminas/laminas-servicemanager":  "^3.11",
        "dotkernel/dot-authorization": "^3.4.1",
        "laminas/laminas-stdlib": "^3.7",
        "laminas/laminas-authentication": "2.16.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^2.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.2"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Rbac\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Rbac\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "static-analysis": "phpstan analyse --memory-limit 1G"
    }
}
